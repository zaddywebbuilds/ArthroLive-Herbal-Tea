---
import '../styles/global.css';
import { site } from '../config/site';
import { withBase } from '../lib/url';
import manifest from '../data/images.json';
import Tracking from '../components/Tracking.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** Preload the LCP hero image on the sales page only. */
  preloadHero?: boolean;
  noindex?: boolean;
}

const {
  title = site.meta.title,
  description = site.meta.description,
  path = '/',
  preloadHero = false,
  noindex = false,
} = Astro.props;

// Astro.site is the deployed origin; Astro.url.pathname already carries the base.
const origin = Astro.site?.origin ?? site.url;
const canonical = new URL(withBase(path), origin).href;
const ogImage = new URL(withBase(site.meta.ogImage), origin).href;

const hero = manifest['arthrolive-herbal-tea-balm-ghana-hero'];
const heroSrcset = hero.sources.map((s) => `${withBase(s.src)} ${s.w}w`).join(', ');
const heroHref = withBase(hero.sources[hero.sources.length - 1].src);
---
<!doctype html>
<html lang="en-GH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta name="theme-color" content="#00565C" />
    <meta name="geo.region" content="GH" />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ArthroLive Ghana" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ArthroLive Herbal Tea pouch and Herbal Balm jar" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {preloadHero && (
      <link
        rel="preload"
        as="image"
        href={heroHref}
        imagesrcset={heroSrcset}
        imagesizes="(min-width: 1024px) 560px, 100vw"
        fetchpriority="high"
      />
    )}

    <slot name="head" />
    <Tracking />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
    <slot />
  </body>
</html>
