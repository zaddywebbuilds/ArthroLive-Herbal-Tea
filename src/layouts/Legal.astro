---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';

interface Props { title: string; heading: string; path: string; description: string }
const { title, heading, path, description } = Astro.props;
---

<Base title={title} description={description} path={path}>
  <Header />
  <main id="main" class="bg-white">
    <div class="wrap max-w-[760px] py-8 md:py-12">
      <a href={withBase("/")} class="text-[14.5px] font-semibold text-teal hover:underline">&larr; Back to ArthroLive</a>
      <h1 class="mt-3 text-[clamp(1.6rem,1.2rem+1.8vw,2.25rem)] font-extrabold text-teal-dark">{heading}</h1>
      <div class="legal mt-4">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style is:global>
  .legal h2 {
    margin-top: 1.75rem;
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-teal-dark);
  }
  .legal p, .legal li { color: var(--color-ink-muted); font-size: 1rem; line-height: 1.65; }
  .legal p { margin-top: 0.65rem; }
  .legal ul { margin-top: 0.65rem; padding-left: 1.1rem; list-style: disc; }
  .legal li { margin-top: 0.35rem; }
  .legal strong { color: var(--color-ink); font-weight: 700; }
</style>
