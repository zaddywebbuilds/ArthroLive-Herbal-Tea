---
import Icon from './Icon.astro';
import Img from './Img.astro';
import manifest from '../data/images.json';
import { site, publishableTestimonials } from '../config/site';

/**
 * Social proof, plus the facts we can stand behind today.
 *
 * Reviews render only when a real customer gave one AND consented to it
 * being published (see site.testimonials). No star ratings are shown and
 * no aggregateRating schema is emitted, because there is no rating data
 * to aggregate. Until reviews exist, the verifiable-facts panel carries
 * the section on its own.
 */
const reviews = publishableTestimonials;
const known = (key?: string) => !!key && Object.prototype.hasOwnProperty.call(manifest, key);

const pillars = [
  site.delivery.freeNationwide && {
    icon: 'truck',
    title: 'Delivery across Ghana',
    body: 'We deliver to all 16 regions. Delivery is free on every package on this page.',
  },
  site.delivery.payOnDelivery && {
    icon: 'hand-coins',
    title: 'Pay when it reaches you',
    body: 'You pay the courier in cash when your package arrives. Nothing is taken upfront.',
  },
  {
    icon: 'phone-call',
    title: 'A real person confirms',
    body: `Our team calls you to confirm your order, your address and the delivery before anything is sent.${site.contact.hours ? ' ' + site.contact.hours + '.' : ''}`,
  },
  {
    icon: 'package-check',
    title: 'Sealed, complete packs',
    body: 'Every package contains the full 20 tea bags and a sealed 50g balm jar in original ArthroLive packaging.',
  },
].filter(Boolean) as { icon: string; title: string; body: string }[];
---
<section id="reviews" class="section-y bg-teal-soft/60 scroll-mt-[60px]">
  <div class="wrap">
    <div class="max-w-[58ch]">
      <span class="eyebrow">{reviews.length ? 'Customers' : 'Ordering With Confidence'}</span>
      <h2 class="h-section mt-1.5 text-teal-dark">
        {reviews.length ? 'What Customers Are Saying' : 'What You Can Count On'}
      </h2>
      {!reviews.length && (
        <p class="mt-1.5 text-ink-muted">
          We only publish customer reviews once they have actually been given to us. Here
          is what we can tell you for certain today.
        </p>
      )}
    </div>

    {reviews.length > 0 && (
      <ul class="mt-3.5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {reviews.map((r) => (
          <li class="card flex flex-col overflow-hidden">
            {r.video ? (
              <video
                class="aspect-[4/3] w-full bg-ink object-cover"
                src={r.video}
                controls
                muted
                playsinline
                preload="metadata"
                aria-label={`Video review from ${r.name}`}
              ></video>
            ) : known(r.photo) ? (
              <Img
                name={r.photo as keyof typeof manifest}
                alt={`${r.name} from ${r.location}`}
                ratio="4/3"
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
              />
            ) : null}
            <div class="flex flex-1 flex-col p-4">
              <Icon name="quote" size={18} class="text-gold" />
              <p class="mt-1.5 text-[15px] leading-snug text-ink">{r.quote}</p>
              <p class="mt-auto pt-3 text-[13.5px] font-bold text-teal-dark">{r.name}</p>
              <p class="text-[13px] text-ink-muted">{r.location}</p>
            </div>
          </li>
        ))}
      </ul>
    )}

    <ul class="mt-3.5 grid grid-cols-2 gap-2.5 sm:gap-3.5 lg:grid-cols-4">
      {pillars.map((p) => (
        <li class="card p-3 sm:p-4">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-green-soft text-green sm:h-10 sm:w-10">
            <Icon name={p.icon} size={19} />
          </span>
          <h3 class="mt-2 text-[14.5px] font-extrabold leading-tight text-teal-dark sm:text-[15.5px]">{p.title}</h3>
          <p class="mt-1 text-[13px] leading-snug text-ink-muted sm:text-[14.5px]">{p.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
