---
import Icon from './Icon.astro';
import { site } from '../config/site';
const items = [
  site.delivery.freeNationwide && { icon: 'truck', text: 'Free Delivery Across Ghana' },
  site.delivery.payOnDelivery && { icon: 'banknote', text: 'Pay on Delivery' },
  { icon: 'phone-call', text: 'We Call to Confirm Every Order' },
].filter(Boolean) as { icon: string; text: string }[];
---
<div class="bg-teal-dark text-white">
  <div class="wrap flex flex-wrap items-center justify-center gap-x-5 gap-y-1 py-2 text-center text-[13px] font-medium">
    {items.map((item, i) => (
      <span class={`inline-flex items-center gap-1.5 whitespace-nowrap ${i > 1 ? 'hidden sm:inline-flex' : ''}`}>
        <Icon name={item.icon} size={15} class="shrink-0 text-gold" />
        {item.text}
      </span>
    ))}
  </div>
</div>
