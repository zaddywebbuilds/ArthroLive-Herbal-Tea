---
/**
 * Quantity illustration for a pricing card. We do not have three distinct
 * bundle photographs, so each card shows an accurate drawn count of the
 * pouches and jars it contains rather than repeating the same photo.
 */
interface Props { tea: number; balm: number }
const { tea, balm } = Astro.props;
const pouches = Array.from({ length: tea });
const jars = Array.from({ length: balm });
---
<div class="flex items-end justify-center gap-1.5 rounded-[12px] bg-gradient-to-b from-teal-soft/80 to-white px-3 py-3.5">
  {pouches.map((_, i) => (
    <svg viewBox="0 0 34 52" width="30" height="46" aria-hidden="true" class="drop-shadow-sm" style={`margin-left:${i ? '-6px' : '0'}`}>
      <rect x="2" y="6" width="30" height="44" rx="3" fill="#00565C" />
      <rect x="2" y="6" width="30" height="7" rx="2.5" fill="#003C40" />
      <circle cx="17" cy="26" r="7.5" fill="#FFF9ED" />
      <path d="M13.5 26c0-2.2 1.7-3.9 3.6-3.9 1.9 0 3.6 1.7 3.6 3.9" stroke="#247541" stroke-width="1.6" fill="none" />
      <rect x="8" y="38" width="18" height="2" rx="1" fill="#D4A017" />
      <rect x="10" y="42" width="14" height="1.6" rx="0.8" fill="#FFF9ED" opacity=".5" />
    </svg>
  ))}
  {jars.map((_, i) => (
    <svg viewBox="0 0 34 36" width="30" height="32" aria-hidden="true" class="drop-shadow-sm" style={`margin-left:${i ? '-6px' : '2px'}`}>
      <rect x="3" y="10" width="28" height="24" rx="3" fill="#FFFFFF" stroke="#CFC6B5" stroke-width="1" />
      <rect x="1.5" y="3" width="31" height="8" rx="3" fill="#00565C" />
      <rect x="1.5" y="9.5" width="31" height="2" fill="#D4A017" />
      <circle cx="17" cy="22" r="5.5" fill="#E8F2EB" />
      <path d="M17 18.5v7M13.5 22h7" stroke="#247541" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  ))}
</div>
