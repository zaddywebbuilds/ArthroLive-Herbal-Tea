---
import Icon from './Icon.astro';
import PackVisual from './PackVisual.astro';
import { formatPrice, type Package } from '../config/site';

interface Props { pkg: Package; featured?: boolean }
const { pkg, featured = false } = Astro.props;
---
<article
  class={`relative flex flex-col rounded-card bg-white ${
    featured
      ? 'border-2 border-gold shadow-[var(--shadow-lift)] md:-my-2'
      : 'border border-line shadow-[var(--shadow-soft)]'
  }`}
>
  {pkg.badge && (
    <span class="absolute -top-2.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-gold px-3 py-0.5 text-[11.5px] font-extrabold uppercase tracking-wide text-[#2a2003] shadow-sm md:-top-3 md:px-3.5 md:py-1 md:text-[12px]">
      {pkg.badge}
    </span>
  )}

  <div class={`flex flex-1 flex-col p-3.5 sm:p-5 ${featured ? 'pt-5 sm:pt-7' : ''}`}>
    <!-- Mobile: pack visual sits beside the name and price, not above it. -->
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 md:block">
      <PackVisual tea={pkg.teaQty} balm={pkg.balmQty} />
      <div class="min-w-0 flex-1 basis-[150px] md:mt-3">
        <h3 class="text-[1.0625rem] font-extrabold leading-tight text-teal-dark md:text-xl">{pkg.name}</h3>
        <p class="mt-0.5 text-[13.5px] font-semibold text-teal md:text-[14.5px]">
          {pkg.teaQty} Herbal {pkg.teaQty > 1 ? 'Teas' : 'Tea'} + {pkg.balmQty} Herbal {pkg.balmQty > 1 ? 'Balms' : 'Balm'}
        </p>
        <p class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <span class="font-display text-[1.75rem] font-extrabold leading-none text-teal-dark md:text-[2rem]">{formatPrice(pkg.price)}</span>
          {pkg.saving > 0 && (
            <span class="inline-flex items-center gap-1 rounded-full bg-green-soft px-2 py-0.5 text-[12.5px] font-bold text-green">
              <Icon name="tag" size={13} stroke={2.4} />
              Save {formatPrice(pkg.saving)}
            </span>
          )}
        </p>
      </div>
    </div>

    <p class="mt-2 text-[13.5px] text-ink-muted md:text-[14px]">{pkg.blurb}</p>

    <ul class="mt-2.5 space-y-1 border-t border-line pt-2.5 text-[13.5px] md:text-[14px]">
      <li class="flex gap-2"><Icon name="check" size={15} class="mt-0.5 shrink-0 text-green" stroke={2.5} /><span>{pkg.teaQty * 20} tea bags and {pkg.balmQty} &times; 50g balm {pkg.balmQty > 1 ? 'jars' : 'jar'}</span></li>
      <li class="flex gap-2"><Icon name="check" size={15} class="mt-0.5 shrink-0 text-green" stroke={2.5} /><span>Free delivery &amp; pay on delivery</span></li>
    </ul>

    <button
      type="button"
      data-select-package={pkg.id}
      class={`mt-3 w-full ${featured ? 'btn-gold' : 'btn-primary'} !min-h-[48px]`}
    >{pkg.cta}</button>
  </div>
</article>
