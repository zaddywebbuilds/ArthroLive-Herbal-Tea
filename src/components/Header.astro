---
import Logo from './Logo.astro';
import { withBase, BASE } from '../lib/url';
import { hasIngredients } from '../config/site';

// On the legal pages these anchors must point back at the sales page.
const here = Astro.url.pathname.replace(/\/$/, '');
const onHome = here === BASE || here === '';
const to = (hash: string) => (onHome ? hash : withBase('/') + hash);
---
<header class="sticky top-0 z-40 border-b border-line bg-white md:bg-white/95 md:backdrop-blur-sm">
  <div class="wrap flex h-[52px] items-center justify-between gap-3 md:h-[58px]">
    <a href={to('#top')} aria-label="ArthroLive home" class="shrink-0">
      <Logo class="h-6 w-auto sm:h-7" />
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-7 text-[15px] font-medium text-ink-muted">
        {hasIngredients && <li><a href={to('#ingredients')} class="hover:text-teal">What's Inside</a></li>}
        <li><a href={to('#benefits')} class="hover:text-teal">Benefits</a></li>
        <li><a href={to('#how-to-use')} class="hover:text-teal">How to Use</a></li>
        <li><a href={to('#faqs')} class="hover:text-teal">FAQs</a></li>
      </ul>
    </nav>

    <a
      href={to('#packages')}
      data-track-cta="header"
      class="btn-primary !min-h-[40px] !px-5 !text-[15px] !shadow-none"
    >Order Now</a>
  </div>
</header>
