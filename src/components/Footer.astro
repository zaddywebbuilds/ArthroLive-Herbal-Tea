---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';

const { phone, whatsapp, email, hours, address } = site.contact;
const year = new Date().getFullYear();
---

<footer class="bg-teal-dark text-white/80">
  <div class="wrap grid gap-6 py-8 md:grid-cols-[1.2fr_1fr_1fr] md:gap-10">
    <div>
      <Logo class="h-7 w-auto" light />
      <p class="mt-3 max-w-[38ch] text-[14.5px] leading-snug">
        ArthroLive Herbal Tea and ArthroLive Herbal Balm, a two product wellness routine
        for everyday body comfort, delivered across Ghana.
      </p>
    </div>

    <div>
      <h2 class="font-display text-[14px] font-extrabold uppercase tracking-wide text-white">Customer support</h2>
      <ul class="mt-1.5 space-y-1 text-[14.5px]">
        {phone && (
          <li>
            <a class="inline-flex items-center gap-2 py-1 hover:text-white" href={`tel:${phone.replace(/\s/g, '')}`}>
              <Icon name="phone" size={16} class="text-gold" />{phone}
            </a>
          </li>
        )}
        {whatsapp && (
          <li>
            <a class="inline-flex items-center gap-2 py-1 hover:text-white" href={`https://wa.me/${whatsapp}`} rel="noopener">
              <Icon name="message-circle" size={16} class="text-gold" />WhatsApp us
            </a>
          </li>
        )}
        {email && (
          <li>
            <a class="inline-flex items-center gap-2 py-1 hover:text-white" href={`mailto:${email}`}>
              <Icon name="mail" size={16} class="text-gold" />{email}
            </a>
          </li>
        )}
        {hours && <li class="inline-flex items-center gap-2"><Icon name="clock" size={16} class="text-gold" />{hours}</li>}
        {address && <li class="inline-flex items-center gap-2"><Icon name="map-pin" size={16} class="text-gold" />{address}</li>}
        {!phone && !whatsapp && !email && (
          <li class="text-white/60">Contact details are added here once confirmed by the business.</li>
        )}
      </ul>
    </div>

    <div>
      <h2 class="font-display text-[14px] font-extrabold uppercase tracking-wide text-white">Information</h2>
      <ul class="mt-1 text-[14.5px]">
        <li><a class="inline-block py-1.5 hover:text-white" href="/delivery-and-returns">Delivery &amp; returns policy</a></li>
        <li><a class="inline-block py-1.5 hover:text-white" href="/privacy-policy">Privacy policy</a></li>
        <li><a class="inline-block py-1.5 hover:text-white" href="/terms-and-conditions">Terms &amp; conditions</a></li>
        <li><a class="inline-block py-1.5 hover:text-white" href="#faqs">Frequently asked questions</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="wrap py-5">
      <h2 class="font-display text-[13px] font-extrabold uppercase tracking-wide text-gold">Product safety notice</h2>
      <p class="mt-2 max-w-[86ch] text-[13.5px] leading-relaxed text-white/70">
        ArthroLive Herbal Tea is a herbal beverage and ArthroLive Herbal Balm is a topical
        balm for external use on intact skin only. Always follow the directions on the
        product label. Keep both products out of reach of children. Stop using the balm if
        your skin reacts to it. These products are not a replacement for medical diagnosis,
        prescribed medication or any treatment your healthcare professional has given you.
        If your symptoms are severe, persistent, unexplained or getting worse, please have
        them assessed by a qualified healthcare professional. If you are pregnant,
        breastfeeding, managing a long-term condition or taking prescribed medication,
        speak to your doctor or pharmacist about the product ingredients before use.
      </p>
      <p class="mt-4 text-[13px] text-white/55">
        &copy; {year} {site.contact.company}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
