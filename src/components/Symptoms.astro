---
import SymptomCard from './SymptomCard.astro';
import Img from './Img.astro';

/**
 * Pain recognition, kept deliberately short. Most visitors arrive from an
 * advert that already named their symptom, so this confirms we understand
 * it and moves on rather than retelling the whole story.
 */
const cards = [
  {
    label: 'Arthritis',
    image: 'arthritis-knee-discomfort',
    alt: 'Older Ghanaian woman sitting on a sofa holding her painful knee',
    title: 'Knees that make every step difficult',
    body: 'Standing up, walking and stairs feel harder when joints are stiff and tender.',
  },
  {
    label: 'Joint Pain',
    image: 'shoulder-joint-pain-after-work',
    alt: 'Ghanaian market trader rubbing a sore shoulder at her vegetable stall',
    title: 'Joints that ache after an ordinary day',
    body: 'A normal day of working or standing leaves shoulders and knees sore.',
  },
  {
    label: 'Rheumatism',
    image: 'rheumatism-stiff-fingers-morning',
    alt: 'Older woman at her kitchen table gently easing stiff fingers in the morning',
    title: 'A body that feels stiff every morning',
    body: 'Getting out of bed and bending your fingers takes longer than it used to.',
  },
  {
    label: 'Sciatica',
    image: 'sciatica-lower-back-leg-pain',
    alt: 'Ghanaian man holding his lower back and thigh as discomfort travels down his leg',
    title: 'Discomfort that travels down your leg',
    body: 'Radiating discomfort makes sitting, standing and walking difficult.',
  },
  {
    label: 'Neuropathy',
    image: 'burning-feet-at-night',
    alt: 'Man sitting on the edge of his bed at night rubbing a burning, tingling foot',
    title: 'Feet that burn even at night',
    body: 'Burning, tingling and numbness make it hard to settle and rest.',
  },
  {
    label: 'Inflammation',
    image: 'swollen-knee-joint-inflammation',
    alt: 'Close-up of swollen, tender knee joints of an older Ghanaian woman seated at home',
    title: 'Joints that feel swollen and tender',
    body: 'Swelling and tenderness get in the way of ordinary movement.',
  },
] as const;
---
<section id="symptoms" class="section-y bg-white">
  <div class="wrap">
    <div class="grid items-center gap-3 md:grid-cols-[1.45fr_1fr] md:gap-8">
      <div class="max-w-[60ch]">
        <span class="eyebrow">Does This Sound Familiar?</span>
        <h2 class="h-section mt-1.5 text-teal-dark">
          You Already Know the Feeling. We Built ArthroLive For It.
        </h2>
        <p class="mt-2 text-ink-muted">
          If any of these is your day, you are in the right place.
        </p>
      </div>
      <Img
        name="morning-joint-stiffness"
        alt="Older Ghanaian man sitting on the edge of his bed, resting his hands on stiff knees before standing"
        ratio="16/10"
        sizes="(min-width: 768px) 360px, 100vw"
        class="hidden rounded-card border border-line md:block"
      />
    </div>

    <ul class="mt-3.5 grid grid-cols-2 gap-2.5 sm:gap-3.5 md:mt-5 lg:grid-cols-3 lg:gap-5">
      {cards.map((c) => <SymptomCard {...c} />)}
    </ul>
  </div>
</section>
